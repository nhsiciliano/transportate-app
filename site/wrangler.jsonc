// Sitio público de Transportate (landing, privacidad, soporte): Worker solo de static assets, sin
// código (`main`), sin bindings y sin observabilidad. Publica `dist/`, la salida de `astro build`
// (correr el build antes del deploy: `pnpm --filter transportate-site run deploy` hace las dos cosas).
// Ver `site/README.md`.
{
  "$schema": "../apps/proxy/node_modules/wrangler/config-schema.json",
  "name": "transportate-site",
  "compatibility_date": "2026-10-28",
  // Dominio propio. Al declarar `routes`, `workers_dev` pasa a false por defecto: se deja en true
  // a propósito, porque el build 1.0.0 (3) de TestFlight enlaza la URL de *.workers.dev.
  "workers_dev": true,
  "routes": [{ "pattern": "transportate.ar", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Con el `html_handling` por defecto (`auto-trailing-slash`), `/privacidad` sirve
    // `privacidad.html`; una ruta inexistente responde 404 con `404.html`.
    "not_found_handling": "404-page",
  },
}
