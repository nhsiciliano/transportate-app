---
// Captura de una pantalla de la app, en claro y oscuro. El tema lo elige la persona con el botón
// de la cabecera (`data-tema` en <html>), no `prefers-color-scheme`, así que no sirve un <source
// media>: van dos <picture> y el CSS (landing.css) muestra el del tema activo. La oscura siempre
// carga diferida, así que en claro no se descarga.
//
// `<Picture />` de astro:assets no acepta otra imagen por `media`, así que el <picture> se arma
// acá con `getImage()` (el mismo procesamiento): AVIF y WebP en cuatro anchos para cada tema, y
// un PNG de respaldo. Los anchos cubren el teléfono más grande de la página (≈ 330 px de
// pantalla) hasta 3x.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

import colectivosClaro from '../assets/capturas/colectivos-claro.png';
import colectivosOscuro from '../assets/capturas/colectivos-oscuro.png';
import favoritosClaro from '../assets/capturas/favoritos-claro.png';
import favoritosOscuro from '../assets/capturas/favoritos-oscuro.png';
import inicioClaro from '../assets/capturas/inicio-claro.png';
import inicioOscuro from '../assets/capturas/inicio-oscuro.png';
import subteClaro from '../assets/capturas/subte-claro.png';
import subteOscuro from '../assets/capturas/subte-oscuro.png';
import trenesClaro from '../assets/capturas/trenes-claro.png';
import trenesOscuro from '../assets/capturas/trenes-oscuro.png';

const capturas = {
  inicio: { claro: inicioClaro, oscuro: inicioOscuro },
  subte: { claro: subteClaro, oscuro: subteOscuro },
  colectivos: { claro: colectivosClaro, oscuro: colectivosOscuro },
  trenes: { claro: trenesClaro, oscuro: trenesOscuro },
  favoritos: { claro: favoritosClaro, oscuro: favoritosOscuro },
} satisfies Record<string, { claro: ImageMetadata; oscuro: ImageMetadata }>;

export type Pantalla = keyof typeof capturas;

interface Props {
  pantalla: Pantalla;
  alt: string;
  /** `sizes` del <picture>: el ancho real de la pantalla del teléfono en cada layout. */
  sizes: string;
  /** La del primer pantallazo: carga ya y con prioridad alta. */
  prioridad?: boolean;
}

const { pantalla, alt, sizes, prioridad = false } = Astro.props;
const { claro, oscuro } = capturas[pantalla];
const anchos = [300, 450, 660, 990];

async function srcset(src: ImageMetadata, format: 'avif' | 'webp') {
  const imagen = await getImage({ src, widths: anchos, format });
  return imagen.srcSet.attribute;
}

const [oscuroAvif, oscuroWebp, claroAvif, claroWebp, respaldoClaro, respaldoOscuro] =
  await Promise.all([
    srcset(oscuro, 'avif'),
    srcset(oscuro, 'webp'),
    srcset(claro, 'avif'),
    srcset(claro, 'webp'),
    getImage({ src: claro, width: 660, format: 'png' }),
    getImage({ src: oscuro, width: 660, format: 'png' }),
  ]);
---

<picture class="captura captura--claro">
  <source type="image/avif" srcset={claroAvif} sizes={sizes} />
  <source type="image/webp" srcset={claroWebp} sizes={sizes} />
  <img
    src={respaldoClaro.src}
    width={claro.width}
    height={claro.height}
    alt={alt}
    decoding="async"
    loading={prioridad ? 'eager' : 'lazy'}
    fetchpriority={prioridad ? 'high' : 'auto'}
  />
</picture>
<picture class="captura captura--oscuro">
  <source type="image/avif" srcset={oscuroAvif} sizes={sizes} />
  <source type="image/webp" srcset={oscuroWebp} sizes={sizes} />
  <img
    src={respaldoOscuro.src}
    width={oscuro.width}
    height={oscuro.height}
    alt={alt}
    decoding="async"
    loading="lazy"
  />
</picture>
