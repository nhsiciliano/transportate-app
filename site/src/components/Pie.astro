---
import { tiendas } from '../config/tiendas';
import Marca from './Marca.astro';

// El crédito de Apple va donde se muestra su insignia: en la landing (la única página con
// accesos a las tiendas) y con la app publicada.
const landing = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const conInsignia = landing && tiendas.appStore !== null;
---

<footer class="pie">
  <div class="pie__fila contenedor">
    <Marca enlace={false} />
    <ul class="pie__enlaces">
      <li>
        <a href="/">Inicio</a>
      </li>
      <li>
        <a href="/privacidad">Privacidad</a>
      </li>
      <li>
        <a href="/soporte">Soporte</a>
      </li>
    </ul>
    <p class="pie__aviso">
      Transportate es una app independiente. No es una app oficial del Gobierno de la Ciudad de
      Buenos Aires ni de Trenes Argentinos.
    </p>
    {conInsignia && (
      <p class="pie__credito">
        Apple y el logotipo de Apple son marcas comerciales de Apple Inc., registradas en EE. UU. y
        en otros países y regiones. App Store es una marca de servicio de Apple Inc.
      </p>
    )}
    <p class="pie__copyright">© 2026 OnionDev</p>
  </div>
</footer>
