---
import Icono from './Icono.astro';
import Marca from './Marca.astro';

export type Pagina = 'inicio' | 'privacidad' | 'soporte';

interface Props {
  actual?: Pagina | undefined;
}

const { actual } = Astro.props;
// Desde otra página, las secciones de la landing llevan a `/#…`.
const base = actual === 'inicio' ? '' : '/';
const enlaces = [
  { href: `${base}#modos`, texto: 'Cómo funciona' },
  { href: `${base}#preguntas`, texto: 'Preguntas' },
  { href: '/privacidad', texto: 'Privacidad', pagina: 'privacidad' },
  { href: '/soporte', texto: 'Soporte', pagina: 'soporte' },
];
---

<div class="avance" aria-hidden="true"></div>
<header class="cabecera">
  <div class="cabecera__fila contenedor">
    <Marca />
    <nav aria-label="Secciones">
      <ul class="cabecera__enlaces">
        {enlaces.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              aria-current={enlace.pagina && enlace.pagina === actual ? 'page' : undefined}
            >
              {enlace.texto}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <!-- Sin JavaScript no hay botón: el sitio queda en claro. src/scripts/tema.ts lo muestra. -->
    <button
      class="tema"
      type="button"
      aria-pressed="false"
      aria-label="Tema oscuro"
      title="Tema oscuro"
      data-tema-boton
      hidden
    >
      <Icono nombre="temaOscuro" class="tema__luna" />
      <Icono nombre="temaClaro" class="tema__sol" />
    </button>
  </div>
</header>
