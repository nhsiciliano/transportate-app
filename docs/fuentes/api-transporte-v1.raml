/colectivos:
  /feed-gtfs:
    is: [client-id-required]
    description: Devuelve GTFS estático en base horarios. Versión con el detalle de horarios para cada parada. Este es el feed a utilizar para las APIs de tiempo real Vehicle Position, Trip Updates y Service Alerts.
    get:
      description: Devuelve GTFS estático en base horarios. Versión con el detalle de horarios para cada parada. Este es el feed a utilizar para las APIs de tiempo real Vehicle Position, Trip Updates y Service Alerts.
      responses: 
        200:
          body: 
            application/zip:
  /feed-gtfs-frequency:
    is: [client-id-required]
    description: Devuelve el feed GTFS estático en base frecuencias. Es una versión simplificada que tiene como objetivo representar las frecuencias o intervalos entre viajes en vez del detalle de horarios para cada parada.
    get:
      description: Devuelve el feed GTFS estático en base frecuencias. Es una versión simplificada que tiene como objetivo representar las frecuencias o intervalos entre viajes en vez del detalle de horarios para cada parada.
      responses: 
        200:
          body: 
            application/zip:    
  /vehiclePositions:
    is: [client-id-required]
    description: !
        "Devuelve la posición de los vehículos monitoreados actualizada cada 30 segundos.
        Si no se pasan parámetros de entrada, retorna la posición actual de todos los vehículos monitoreados."
    get:
      description: !
        "Devuelve la posición de los vehículos monitoreados actualizada cada 30 segundos.
        Si no se pasan parámetros de entrada, retorna la posición actual de todos los vehículos monitoreados." 
      queryParameters: 
        json:
          description: Si el valor es 1 devuelve la respuesta en formato json. Por default lo hace en formato protobuf
          type: integer
          required: false
        agency_id:
          type: integer
          required: false
        route_id:
          type: integer
          required: false
        Trip:
          type: string
          required: false
      responses:  
         200:
          body: 
            application/json:
              examples:
                #sin_filtro:  !include buses_positions.json
                #filtro_route_id: !include vehicle-position_routeid_580.json
            application/x-protobuf:
              properties:
                entity: FeedEntityVehiclePosition[]
                header: FeedHeader
  /vehiclePositionsSimple:
    is: [client-id-required]
    description: |
        Devuelve la posición de los vehículos monitoreados actualizada cada 30 segundos con el formato simplificado, agregando el route_short_name (línea de colectivo) a la respuesta.
    get:
      description: |
        Devuelve la posición de los vehículos monitoreados actualizada cada 30 segundos con el formato simplificado, agregando el route_short_name (línea de colectivo) a la respuesta.
      queryParameters: 
        route_id:
          type: string
          required: false
        agency_id:
          type: integer
          required: false
        Trip:
          type: string
          required: false
      responses: 
        200:
          body: 
            application/json:
              #example: !include moovit.json

  /serviceAlerts:
    is: [client-id-required]
    description: !
        "Las alertas de servicio te permiten proporcionar actualizaciones cada vez que 
        se produce una interrupción en la red. Las demoras y cancelaciones de viajes 
        individuales a menudo se deben comunicar a través de los trip updates."
    get:
      description: !
        "Las alertas de servicio te permiten proporcionar actualizaciones cada vez que 
        se produce una interrupción en la red. Las demoras y cancelaciones de viajes 
        individuales a menudo se deben comunicar a través de los trip updates."
      queryParameters:
        json:
          type: integer
          required: false
        agency_id:
          type: string
          required: false
        route_id:
          type: string
          required: false
        Trip:
          type: string
          required: false
      responses:
        200:
          body:
            application/x-protobuf:
              properties:
                header: FeedHeader
                entity: FeedEntityAlert 
            application/json:
              properties:
                header: FeedHeader
                entity: FeedEntityAlert
              example:
                header: {
                  gtfs_realtime_version: "1.0",
                  incrementality: 0,
                  timestamp: 1525802328
                }
                entity:  {
                  active_period: [
                    {
                      start: 1525888786,
                      end: 1525888983,
                    },
                    {
                      start: 1525890087,
                      end: 1525989878,
                    }      
                  ],
                  informed_entity: [
                    {
                      agency_id: "",
                      route_id: "",
                      route_type: 0,
                      stop_id: ""
                    }
                  ],
                  cause: 3,
                  effect: 3,
                  header_text: [
                      {
                        text: "Servicio con demoras - 60",
                        language: "es"
                      },
                      {
                        text: "Significant delays - 60",
                        language: "en"
                      }
                  ],
                  description_text: [
                    {
                      text: "Línea 60 - Servicio con demora por problemas técnicos",
                      language: "es"
                    },
                    {
                      text: "60 - Significant delays due to technical problems",
                      language: "en"
                    }
                  ]
                }

/ecobici:
  /gbfs:
    description: General Bikeshare Feed Specification (GBFS)
    /systemInformation:
      is: [client-id-required]
      description: Describe el sistema incluyendo operador del sistema, ubicación del sistema, año implementado, URLs, información de contacto y zona horaria.
      get:
        description: Describe el sistema incluyendo operador del sistema, ubicación del sistema, año implementado, URLs, información de contacto y zona horaria.
        responses:
          200:
            body:
              application/json:
                example: 
                  {
                    "last_updated": 1560973300,
                    "ttl": 30,
                    "data": {
                      "system_id": "bike_buenosaires",
                      "language": "en",
                      "name": "Ecobici",
                      "timezone": "America/Argentina/Buenos_Aires",
                      "build_version": "2019.5.2",
                      "build_label": "",
                      "build_hash": "",
                      "build_number": "22",
                      "mobile_head_version": "2",
                      "mobile_minimum_supported_version": "1"
                    }
                  }
    /stationStatus:
      is: [client-id-required]
      description: Número de bicicletas y anclajes disponibles en cada estación y disponibilidad de estación.
      get:
        description: Número de bicicletas y anclajes disponibles en cada estación y disponibilidad de estación.
        responses:
          200:
            body:
              application/json:
                example: 
                 {
                     "last_updated":1560973477,
                     "ttl":23,
                     "data":{
                        "stations":[
                           {
                              "station_id":"2",
                              "num_bikes_available":0,
                              "num_bikes_available_types":{
                                 "mechanical":0,
                                 "ebike":0
                              },
                              "num_bikes_disabled":0,
                              "num_docks_available":20,
                              "num_docks_disabled":0,
                              "is_installed":1,
                              "is_renting":1,
                              "is_returning":1,
                              "last_reported":1560892904,
                              "is_charging_station":false,
                              "status":"IN_SERVICE"
                           }
                        ]
                     }
                  } 
    /stationInformation:
      is: [client-id-required]
      description: Listado estático de todas las estaciones, sus capacidades y ubicaciones.
      get:
        description: Listado estático de todas las estaciones, sus capacidades y ubicaciones.
        responses:
          200:
            body:
              application/json:
                example:
                  {
                     "last_updated":1560973383,
                     "ttl":17,
                     "data":{
                        "stations":[
                           {
                              "station_id":"2",
                              "name":"002 - Retiro I",
                              "physical_configuration":"SMARTLITMAPFRAME",
                              "lat":-34.5924233,
                              "lon":-58.3747151,
                              "altitude":0,
                              "address":"Ramos Mejia, Jose Maria, Dr. Av. & Del Libertador Av.",
                              "post_code":"11111",
                              "capacity":20,
                              "rental_methods":[
                                 "KEY",
                                 "TRANSITCARD",
                                 "PHONE"
                              ],
                              "groups":[
                                 "RETIRO"
                              ],
                              "obcn":""
                           }
                        ]
                     }
                  }
/estacionamiento:
   description: |
        Búsqueda de información de estacionamiento en vía pública para un tramo de una calle de la Ciudad Autónoma de Buenos Aires. Dado un punto y un radio, busca información de estacionamiento en esa área circular.
   
   /garajesComerciales:  
      is: [client-id-required, transito-estacionamiento-params]
      description: |
        Este servicio permite buscar información de garajes comerciales para un tramo de una calle de la Ciudad Autónoma de Buenos Aires.
      get:
        responses:
          200:
            body:
              application/json:
                example: !include Examples/garage-comercialExample.json
   
   /cajonesCargaDescarga: 
      is: [client-id-required, transito-estacionamiento-params]
      description: |
        Este servicio permite buscar información de cajones de Carga y Descarga para un tramo de una calle de la Ciudad Autónoma de Buenos Aires.
      get:
        responses:
          200:
            body:
              application/json:
                example: !include Examples/carga-descargaExample.json
                
   /cajonesParadasColectivo: 
      is: [client-id-required, transito-estacionamiento-params]
      description: |
        Este servicio permite buscar información de cajones para paradas de colectivos para un tramo de una calle de la Ciudad Autónoma de Buenos Aires.
      get:
        responses:
          200:
            body:
              application/json:
                example: !include Examples/parada-colectivoExample.json
                
   /cajonesEstacionamientosMoto: 
      is: [client-id-required, transito-estacionamiento-params]
      description: |
        Este servicio permite buscar información de cajones para estacionamientos de motos para un tramo de una calle de la Ciudad Autónoma de Buenos Aires.
      get:
        responses:
          200:
            body:
              application/json:
                example: !include Examples/estacionamiento-motoExample.json
                     
  
/transito:
  /v1:
    /estacionamientos:
      is: [client-id-required, transito-estacionamiento-params]
      description: |
          Búsqueda de información de estacionamiento en vía pública para un tramo de una calle de la Ciudad Autónoma de Buenos Aires. Dado un punto y un radio, busca información de estacionamiento en esa área circular.
      get:
        description: |
          Búsqueda de información de estacionamiento en vía pública para un tramo de una calle de la Ciudad Autónoma de Buenos Aires. Dado un punto y un radio, busca información de estacionamiento en esa área circular.
        responses:
          200:
            body:
              application/json:
                type: object
                properties: 
                  total: number
                  totalFull: number
                  instancias: ParkingEntity[]
                examples:
                  fullInfo: !include ParkingExample.json
      
