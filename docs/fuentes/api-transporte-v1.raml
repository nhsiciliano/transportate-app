/datos:
  /movilidad:  
    /transito:
      is: [client-id-required]
      description: Reporte de datos del conteo vehicular proveniente de los sensores de la Ciudad. La información está agregada por hora y zona de captura. La zona de captura se encuentra codificada en Open Location Code. Estos datos se actualizan cada hora, con una ventana de 35 dias calendarios, incluyendo el día actual.
      get:
        responses:
          200:
            description: Reporte de tránsito horario como JSON
            body:
              application/json:
                type: ConteoTransito
      /mensual:
        is: [client-id-required]
        description: Reporte de datos del conteo vehicular proveniente de los sensores de la Ciudad, del último mes completo (no del que esta en curso).
        get:
          responses:
            200:
              description: Reporte de tránsito horario del último mes como CSV
              body:
                text/csv:
                  type: ConteoTransito
        /{anioMes}:
          is: [client-id-required]
          description: Reporte de datos del conteo vehicular proveniente de los sensores de la Ciudad de un mes especifico. Por ejemplo, si se desea el reporte mensual de marzo de este año, se debe ingresar 2020-03 en la url. Se cuenta con los datos a partir de Febrero del año 2020.
          uriParameters:
            anioMes:
              type: string
              required: true
              description: el año y el mes especifico     
          get:
            responses:
              200:
                body:
                  text/csv:
                    type: ConteoTransito
      
      /semanaTipica:
        is: [client-id-required]
        description: Reporte con la información de una semana típica (funcionamiento con actividad normal) del conteo vehicular. La semana es seleccionada por un equipo de ingenieros civiles. Esta información es útil para comparar el comportamiento actual con el esperado al comparar los conteos.
        get:
          responses:
            200:
              description: Reporte de tránsito horario de la semana típica como JSON
              body:
                application/json:
                  type: ConteoTransito
  
    /transportePublico:
      is: [client-id-required]
      description: Reporte de conteos de transacciones SUBE (colectivos, trenes y subtes). La información se encuentra agregada por día y se dividen los conteos para cada modo de transporte. Estos datos se actualizan a día vencido, con una ventana de 35 días calendarios.
      get:
        responses:
          200:
            description: Reporte de transporte público diario como JSON
            body:
              application/json:
                type: ConteoTransporte
                  
      /mensual:
        is: [client-id-required]
        description: Reporte de datos del conteo de transacciones SUBE, del último mes completo, no del que está en curso.
        get:
          responses:
            200:
              description: Reporte de transporte público diario del último mes como CSV
              body:
                text/csv:
                  type: ConteoTransporte
                  
        /{anioMes}:
          is: [client-id-required]
          description: Reporte de datos del conteo de transacciones SUBE, de un mes específico, donde anioMes debe proporcionarse en formato aaaa-mm siendo aaaa el año y mm el mes. Por ejemplo, si se desea el reporte mensual de marzo de este año, se debe ingresar 2020-03 en la url. Se cuenta con los datos a partir de Marzo del año 2020.
          uriParameters:
            anioMes:
              type: string
              required: true
              description: el año y el mes especifico  
                 
          get:
            responses:
              200:
                body:
                  text/csv:
                    type: ConteoTransporte
    
      /semanaTipica:
        is: [client-id-required]
        description: Reporte con la información de una semana típica (funcionamiento con actividad normal) del conteo de transacciones SUBE. La semana es seleccionada por un equipo de ingenieros civiles. Esta información es útil para comparar el comportamiento actual con el esperado al comparar los conteos.
        get:
          responses:
            200:
              description: Reporte de transporte público diario de la semana típica como JSON
              body:
                application/json:
                  type: ConteoTransporte
                  
       