{
  "name": "transportate-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Proxy/BFF de Transportate sobre Cloudflare Workers (Hono).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
