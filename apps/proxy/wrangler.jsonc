// Configuración del Worker `transportate-proxy`.
// Secrets (GCBA_CLIENT_ID, GCBA_CLIENT_SECRET): en local van en `.dev.vars` (ver
// `.dev.vars.example` en la raíz); en producción, con `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transportate-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  // Privacidad: el Worker no loguea requests (ni IP, ni User-Agent, ni URLs upstream,
  // que llevan el secret en la query). Solo logs propios y sin datos identificables,
  // muestreados al 10 %. Los invocation logs (metadatos de cada request) quedan apagados.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
  // Rate limiting nativo de Workers: contadores en memoria por colo, no persiste IPs.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Paquete estático versionado (paradas, estaciones, líneas) generado por tools/gtfs.
  "r2_buckets": [
    {
      "binding": "STATIC",
      "bucket_name": "transportate-static",
      "preview_bucket_name": "transportate-static-preview",
    },
  ],
  // Trenes (SOFSE vía la API comunitaria, sin credenciales): `TRENES_ENABLED` distinto de "true"
  // apaga la fuente (kill-switch); TTL de arribos y de estado/alertas por separado.
  "vars": {
    "FEED_TTL_SECONDS": "20",
    "STATIC_TTL_SECONDS": "86400",
    "UPSTREAM_TIMEOUT_MS": "5000",
    "TRENES_UPSTREAM_BASE": "https://ariedro.dev/api-trenes",
    "TRENES_ENABLED": "true",
    "TRENES_TTL_SECONDS": "30",
    "TRENES_ESTADO_TTL_SECONDS": "60",
    "ENVIRONMENT": "dev",
  },
  // Entornos desplegables (`wrangler deploy --env preview|production`). Los bindings y
  // las vars NO se heredan de la raíz: se repiten en cada entorno. Los secrets se cargan
  // por entorno con `wrangler secret put <NOMBRE> --env <entorno>`. Ver docs/10-deploy.md.
  "env": {
    // Worker `transportate-proxy-preview`, solo en *.workers.dev (sin Cache API efectiva).
    "preview": {
      "workers_dev": true,
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "r2_buckets": [
        {
          "binding": "STATIC",
          "bucket_name": "transportate-static-preview",
        },
      ],
      "vars": {
        "FEED_TTL_SECONDS": "20",
        "STATIC_TTL_SECONDS": "86400",
        "UPSTREAM_TIMEOUT_MS": "5000",
        "TRENES_UPSTREAM_BASE": "https://ariedro.dev/api-trenes",
        "TRENES_ENABLED": "true",
        "TRENES_TTL_SECONDS": "30",
        "TRENES_ESTADO_TTL_SECONDS": "60",
        "ENVIRONMENT": "preview",
      },
    },
    // Worker `transportate-proxy-production`. Hasta tener dominio propio queda en
    // *.workers.dev (la Cache API solo funciona con dominio o ruta propia). Al asignarlo:
    // agregar `routes` con `custom_domain: true` y dejar `workers_dev` en true hasta que
    // ningún build publicado apunte a workers.dev; recién ahí pasa a false (docs/10-deploy.md §4).
    "production": {
      "workers_dev": true,
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "r2_buckets": [
        {
          "binding": "STATIC",
          "bucket_name": "transportate-static",
        },
      ],
      "vars": {
        "FEED_TTL_SECONDS": "20",
        "STATIC_TTL_SECONDS": "86400",
        "UPSTREAM_TIMEOUT_MS": "5000",
        "TRENES_UPSTREAM_BASE": "https://ariedro.dev/api-trenes",
        "TRENES_ENABLED": "true",
        "TRENES_TTL_SECONDS": "30",
        "TRENES_ESTADO_TTL_SECONDS": "60",
        "ENVIRONMENT": "production",
      },
    },
  },
}
