# Copiá este archivo a `.env` (está en .gitignore) y ajustá la URL.
# Expo expone a la app solo las variables con prefijo EXPO_PUBLIC_
# (https://docs.expo.dev/guides/environment-variables/). Nunca pongas secretos acá:
# quedan embebidos en el bundle.
#
# Proxy local con `pnpm --filter transportate-proxy dev` (wrangler dev).
# En un dispositivo físico o en el emulador de Android, `localhost` no es tu máquina:
# usá la IP de tu red local (o `10.0.2.2` en el emulador de Android).
EXPO_PUBLIC_API_URL=http://localhost:8787
